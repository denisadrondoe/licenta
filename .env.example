# Model pentru fisierul .env (setup.bat il copiaza automat ca .env).
# Completeaza in .env doar valorile secrete (tokenurile si cheia API).
# Fisierul .env NU se urca niciodata pe GitHub (este in .gitignore).

# --- Jira (planificarea task-urilor) ---
JIRA_URL=https://drondoedenisa.atlassian.net
JIRA_EMAIL=drondoedenisa5@gmail.com
JIRA_TOKEN=pune-aici-tokenul-jira
JIRA_PROJECT=SCRUM

# --- GitLab (proiectul de test, doar citire) ---
GITLAB_URL=https://gitlab.com
GITLAB_TOKEN=pune-aici-tokenul-gitlab
GITLAB_PROJECT=licenta-denisa/proiect-test

# --- LLM ---
# (se va actualiza daca folosim Azure OpenAI in loc de Anthropic)
ANTHROPIC_API_KEY=pune-aici-cheia-api
ANTHROPIC_MODEL=claude-sonnet-4-5
